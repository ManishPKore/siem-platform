# PostgreSQL
POSTGRES_URL=postgresql+psycopg2://siem:siem_dev_password@localhost:5432/siem

# Discrete variables below are consumed directly by the `postgres` container in
# docker-compose.yml (the official postgres image needs these three, it
# can't take a URL) -- keep them in sync with POSTGRES_URL above.
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_dev_password
POSTGRES_DB=siem
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ES_HOST=http://localhost:9200

# Kibana
KIBANA_HOST=http://localhost:5601

# Alerting

# Webhook alerting (Slack or Discord). Leave blank to disable.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_PLATFORM=auto
ALERT_WEBHOOK_MIN_SEVERITY=HIGH
ALERT_WEBHOOK_RATE_LIMIT_SECONDS=900
ALERT_WEBHOOK_TIMEOUT_SECONDS=5

# SMTP (for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Optional email alert settings
ALERT_EMAIL_FROM=siem-alerts@siem.local
ALERT_EMAIL_MIN_SEVERITY=HIGH
ALERT_EMAIL_RATE_LIMIT_SECONDS=900
SMTP_TIMEOUT_SECONDS=10

# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=true

# GeoIP enrichment (MaxMind GeoLite2-City; see README "GeoIP Database Setup")
GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# ASN enrichment (MaxMind GeoLite2-ASN; see README "ASN Database Setup")
ASN_DB_PATH=data/GeoLite2-ASN.mmdb

# Threat intelligence / IP reputation (see README "Threat Intelligence Setup")
# Free key: https://www.abuseipdb.com/register  (free tier: 1000 checks/day).
# Leave blank to use only the local blocklist (data/known_bad_ips.txt).
ABUSEIPDB_API_KEY=
# Score (0-100) at or above which an IP counts as a known threat.
ABUSEIPDB_THREAT_THRESHOLD=50
# Local daily call budget per Spark worker (free tier = 1000).
ABUSEIPDB_DAILY_LIMIT=1000
# Local blocklist fallback file (one IP or CIDR per line).
KNOWN_BAD_IPS_PATH=data/known_bad_ips.txt

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me