# PostgreSQL
POSTGRES_URL=postgresql+psycopg2://siem:siem_dev_password@localhost:5432/siem
# Discrete vars below are consumed directly by the `postgres` container in
# docker-compose.yml (the official postgres image needs these three, it
# can't take a URL) -- keep them in sync with POSTGRES_URL above.
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_dev_password
POSTGRES_DB=siem
POSTGRES_PORT=5432

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Elasticsearch
ES_HOST=http://localhost:9200

# Alerting
ALERT_WEBHOOK_URL=

# SMTP (for email alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Threat intelligence
ABUSEIPDB_API_KEY=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me